<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Menu</title>
</head>
<body>
    <h1>Our Menu</h1>
    <ol>
        <% for (let item of menu) { %>
            <li>
                <strong><%= item.name %></strong>
                <span><%= item.description %></span>
                <span><%= item.price %></span>
            </li>
        <% } %>
    </ol>
</body>
</html>